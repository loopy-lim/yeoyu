{
  "name": "yeoyu",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.4.3",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "codegen": "bun .deps/rustra-main/packages/cli/src/index.ts codegen --config rustra.json"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@rustra/generated-react-native": "workspace:*",
    "@rustra/react-native": "file:.deps/rustra-main/packages/react-native",
    "@rustra/types": "file:.deps/rustra-main/packages/types",
    "@unikit-bridge/ui": "file:.deps/unikit",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-svg": "15.15.5",
    "react-native-url-polyfill": "4.0.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "uniwind": "1.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/runtime": "^7.29.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "prettier": "3.9.10",
    "react-test-renderer": "19.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">= 26.0.0"
  },
  "overrides": {
    "@rustra/types": "file:.deps/rustra-main/packages/types"
  },
  "codegenConfig": {
    "name": "BrowserSurfaceSpec",
    "type": "components",
    "jsSrcsDir": "modules/browser-surface/src",
    "android": {
      "javaPackageName": "dev.browser"
    }
  },
  "workspaces": [
    "modules/rustra-jsi"
  ]
}
