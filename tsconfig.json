{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // The RN preset assumes Jest globals; the test suite runs on Bun instead.
    "types": ["bun", "uniwind/types"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./modules/*"],
      "@generated/*": ["./generated/*"],
      "@styles/global.css": ["./global.css"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "native/generated", ".deps"]
}
