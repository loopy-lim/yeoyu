{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // The RN preset assumes Jest globals; the test suite runs on Bun instead.
    "types": ["bun"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods",
    "native/generated"
  ]
}
