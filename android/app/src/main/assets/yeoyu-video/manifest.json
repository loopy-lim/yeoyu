{
  "manifest_version": 2,
  "name": "Yeoyu video region",
  "version": "1.0.5",
  "browser_specific_settings": {
    "gecko": { "id": "video-pip@yeoyu" }
  },
  "permissions": ["<all_urls>", "geckoViewAddons", "nativeMessaging", "nativeMessagingFromContent"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
